{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectra Workbench capability descriptor",
  "$comment": "Initial contract. Runtime adapters must apply semantic validation beyond this schema. Template-only records must not be executed.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "template_only": {
      "type": "boolean",
      "default": false
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "descriptor_revision": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "algorithm",
        "cli",
        "function",
        "class",
        "method",
        "property",
        "enum",
        "config",
        "driver"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "native_name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "description": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "version_constraint": {
          "type": "string",
          "minLength": 1
        },
        "runtime_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider_id",
        "version_constraint",
        "runtime_id",
        "resolved_version"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "documentation_url": {
          "type": "string",
          "minLength": 1
        },
        "baseline_id": {
          "type": "string",
          "minLength": 1
        },
        "upstream_version": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "verified_date": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "documentation_url",
        "baseline_id",
        "upstream_version",
        "snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "native_name": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "dataset",
              "output",
              "file",
              "directory",
              "uri",
              "band",
              "bands",
              "crs",
              "bbox",
              "resolution",
              "integer",
              "number",
              "boolean",
              "enum",
              "string",
              "list",
              "key_value",
              "expression",
              "sql",
              "json",
              "object",
              "script",
              "callback"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "repeatable": {
            "type": "boolean"
          },
          "default": {},
          "choices": {
            "type": "array"
          },
          "constraints": {
            "type": "object",
            "additionalProperties": true
          },
          "help": {
            "type": "string"
          },
          "advanced": {
            "type": "boolean"
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "key",
          "native_name",
          "label",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "type": "string",
            "enum": [
              "raster",
              "vector",
              "table",
              "array",
              "scalar",
              "artifact",
              "any"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "multiple": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "data_type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "type": "string",
            "enum": [
              "raster",
              "vector",
              "table",
              "array",
              "scalar",
              "artifact",
              "any"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "multiple": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "data_type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "package",
              "driver",
              "service",
              "data",
              "native_extension",
              "configuration"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "constraint": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "name",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "script",
              "cli",
              "form",
              "specialized",
              "documentation"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "target",
          "available"
        ],
        "additionalProperties": false
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "presence": {
          "type": "string",
          "enum": [
            "present",
            "missing",
            "unknown"
          ]
        },
        "binding": {
          "type": "string",
          "enum": [
            "none",
            "indexed",
            "script",
            "cli",
            "form",
            "specialized"
          ]
        },
        "validation": {
          "type": "string",
          "enum": [
            "not_run",
            "smoke_passed",
            "numerical_passed",
            "failed",
            "not_applicable"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "ready",
            "missing_dependency",
            "unsupported",
            "blocked",
            "unknown"
          ]
        }
      },
      "required": [
        "presence",
        "binding",
        "validation",
        "availability"
      ],
      "additionalProperties": false
    },
    "effects": {
      "type": "string",
      "enum": [
        "read_only",
        "new_dataset",
        "in_place",
        "external_write",
        "mixed"
      ]
    },
    "cancellation": {
      "type": "string",
      "enum": [
        "cooperative",
        "process_termination",
        "unsupported",
        "unknown"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "awaiting_data"
            ]
          },
          "report_uri": {
            "type": "string",
            "minLength": 1
          },
          "runtime_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case_id",
          "status",
          "report_uri",
          "runtime_id"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "descriptor_revision",
    "kind",
    "name",
    "native_name",
    "category",
    "engine",
    "source",
    "parameters",
    "inputs",
    "outputs",
    "requirements",
    "entrypoints",
    "state",
    "effects",
    "cancellation",
    "limitations",
    "validation_evidence"
  ],
  "additionalProperties": false
}
