{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectra Workbench JSONL message envelope",
  "$comment": "Each serialized message occupies one UTF-8 JSONL line. Payload-specific semantic checks and byte-size limits are enforced by the transport implementation.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "template_only": {
      "type": "boolean",
      "default": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "hello",
        "ready",
        "request",
        "accepted",
        "progress",
        "log",
        "artifact",
        "result",
        "error",
        "cancel",
        "heartbeat"
      ]
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "protocol_version",
    "kind",
    "message_id",
    "request_id",
    "task_id",
    "worker_id",
    "generation",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hello"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "provider_id": {
                "type": "string",
                "minLength": 1
              },
              "worker_package_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider_id",
              "worker_package_version"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ready"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "runtime_id": {
                "type": "string",
                "minLength": 1
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "runtime_id"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "action",
              "arguments"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "accepted"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "attempt"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "progress"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "phase": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "ratio",
              "phase"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "log"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "DEBUG",
                  "INFO",
                  "WARNING",
                  "ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "stream": {
                "type": "string",
                "enum": [
                  "stdout",
                  "stderr",
                  "engine",
                  "application"
                ]
              }
            },
            "required": [
              "level",
              "message"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "artifact"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "commit_state": {
                "type": "string",
                "enum": [
                  "staging",
                  "committed",
                  "partial",
                  "failed"
                ]
              }
            },
            "required": [
              "artifact_id",
              "uri",
              "kind",
              "commit_state"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed",
                  "cancelled",
                  "interrupted"
                ]
              },
              "artifact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "status",
              "artifact_ids"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "error"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cancel"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "heartbeat"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "monotonic_seconds": {
                "type": "number",
                "minimum": 0
              },
              "active_task_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "monotonic_seconds"
            ],
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
